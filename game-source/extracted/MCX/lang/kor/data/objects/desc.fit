[Desc500]	// apc
st DescString = "(멀티플레이 전용 - 사용되지 않음)"

[Desc501]	// ARMORED CAR
st DescString = "(멀티플레이 전용 - 사용되지 않음)"

[Desc502]	// bulldog
st DescString = "불독은 중오토캐논을 탑재한, 느리지만 튼튼한 단거리 파괴 기계이다."

[Desc503]	// condor
st DescString = "콘도르는 대형 펄스 레이저를 쏘는, 균형 잡힌 중거리 전차이다."

[Desc504]	// harasser
st DescString = "해러서는 SRM 팩을 탑재한 튼튼한 단거리 전투 차량이다. 운전병들은 속도를 살려 재빠르게 훑고 지나가며 공격한 뒤 안전한 곳으로 빠진다."

[Desc505]	// j. edgar
st DescString = "J. 에드거는 펄스 레이저를 쏘는, 장갑이 얇은 신속 타격 전차이다. 무리 지어 작전할 때 운전병들은 적의 주의를 흩뜨리는 선회 전술을 즐겨 쓴다."

[Desc506]	// LRM carrier
st DescString = " LRM 캐리어는 LRM 랙을 쏘는 위험한 경장갑 미사일 차량이다."

[Desc507]	// minelayer
st DescString = "지뢰 부설차는 적의 이동을 지연시키고 한곳으로 몰기 위한 방어용 유닛이다."

[Desc508]	// minesweeper
st DescString = "지뢰 제거차는 적의 지뢰를 안전하게 터뜨려 지뢰밭 사이로 길을 낸다. 하지만 지뢰를 하나 터뜨릴 때마다 차량의 성능이 떨어진다."

[Desc509]	// Pegasus
st DescString = "페가수스는 센서를 갖춘 무장 정찰 차량이다."

[Desc510]	// refit truck
st DescString = "정비 트럭은 배틀메크의 장갑을 현장에서 수리하고 소모된 탄약을 보충한다."

[Desc511]	// rommel
st DescString = "롬멜은 쌍열 오토캐논을 쏘는, 장갑이 두꺼운 중거리 강타 전차이다."

[Desc512]	// Saracen
st DescString = "사라센은 경오토캐논을 쏘는 빠른 장거리 타격 차량이다. 무리 지어 작전할 때 조종수들은 한 목표에 화력을 집중한 뒤 다음 희생양으로 넘어가는 경향이 있다."

[Desc513]	// Savannah master
st DescString = "사바나 마스터는 장갑은 빈약하지만 속도가 매우 빠른 단거리 전투 차량이다. 무리 지어 다니며 목표를 에워싸 달아나지 못하게 한다."

[Desc514]	// shrek
st DescString = "느리게 움직이지만 슈렉에 실린 여러 문의 ER-PPC를 조심하라. 주의하라! 이 차량이 멈추면 곧 발사한다!"

[Desc515]	// SRM carrier
st DescString = "SRM 캐리어는 여러 개의 SRM 팩을 쏘는 빠른 경장갑 미사일 차량이다. 바짝 다가와 일제 사격을 퍼부은 뒤 SRM을 재장전하는 동안 물러나는 경향이 있다."

[Desc516]	// striker
st DescString = "스트라이커는 큰 피해를 견디는 동시에 큰 피해를 입힐 수도 있는 장거리 미사일 전차이다."

[Desc517]	// swiftwind
st DescString = "스위프트윈드는 센서를 갖춘 비무장 경장갑 정찰 차량이다."

[Desc518]	// von luckner
st DescString = "폰 루크너는 경오토캐논과 가우스 라이플을 쏘는, 장갑이 두꺼운 장거리 강습 차량이다. 주의하라! 이 차량이 멈추면 곧 발사한다!"

[Desc550]	// centipede scout car
st DescString = "빠르고 중무장한 이 정찰차는 가디언 전자전 방해 장비와 고급 차량 센서를 갖추었다."

[Desc551]	// regulator heavy tank
st DescString = "빠르고 날렵한 이 전차는 대부분의 목표를 한 발에 박살 낼 수 있는 거대한 가우스 라이플을 탑재했다. 속도를 살려 메크의 약한 후면 장갑을 이 무기로 노릴 수 있다."

[Desc552]	// manticore heavy tank
st DescString = "맨티코어는 뛰어난 장갑 방호력과 효과적인 장거리 및 중거리 화력을 갖춘 중전차이다."

[Desc553]	// pilum heavy tank
st DescString = "이 형식의 필룸 중전차는 화력 일부를 포기하는 대신 더 큰 동력원을 달아, 같은 체급의 어떤 차량보다도 빠르다."

[Desc554]	// alacorn mkvii heavy tank
st DescString = "스타 리그 시대의 설계인 알라콘 MKIV는 적당한 속도, 뛰어난 장갑, 무시무시한 타격력을 날렵한 차체 하나에 담았다."

[Desc555]	// ammo truck
st DescString = "탄약 트럭은 값싸고 꽤 빠르지만 폭발 위험이 있는 차량으로, 메크의 탄약은 보충할 수 있으나 장갑은 수리하지 못한다. 조작법은 정비 트럭과 같다."

FITend
