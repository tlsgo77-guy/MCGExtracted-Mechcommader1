FITini
//IS COMPONENTS

[Desc13]		//SENSOR (BASIC)
st DescString = "IS 센서는 약 350미터 이내에서 가동 중인 적 유닛을 탐지한다. 엘리멘탈이나 전원이 차단된 메크는 탐지하지 못한다.%n적재값:%fc8  0.0" 

[Desc14]		//SENSOR (INTERMEDIATE)
st DescString = "IS 중급형 센서는 약 440미터 이내에서 가동 중인 적 유닛을 탐지한다. 엘리멘탈이나 전원이 차단된 메크는 탐지하지 못한다. %n적재값:%fc8  0.5"

[Desc15]		//SENSOR (ADVANCED)
st DescString = "IS 고급형 센서는 약 525미터 이내에서 가동 중인 적 유닛을 탐지한다. 엘리멘탈이나 전원이 차단된 메크는 탐지하지 못한다. *레이븐 또는 클랜 경량급 메크 전용.*  적재값:%fc8  1.0"

[Desc37]		//BEAGLE ACTIVE PROBE
st DescString = "IS 비글 액티브 프로브를 달면 모든 아군 유닛이 각자의 센서 범위 안에서 전원이 차단된 메크를 탐지할 수 있다. *레이븐 또는 클랜 경량급 메크 전용.*%n적재값:%fc8  1.5"

[Desc38]		//GUARDIAN ECM SUITE
st DescString = "IS 가디언 ECM 장비는 접촉한 적 센서의 탐지 거리를 절반으로 줄인다. *레이븐 또는 클랜 경량급 메크 전용.*  %n적재값:%fc8  1.5"

[Desc98]		//RAIL GUN (SL)
st DescString = "잃어버린 기술을 쓰는 스타 리그 시대의 유물인 레일건은 거대한 금속 탄체를 전자기력으로 쏘아 보낸다. 탄약이 제한적이다. (15발) 적재값:%fc8  30.0"

[Desc99]		//LIGHT GAUSS RIFLE (IS)
st DescString = "이너 스피어의 새로운 설계로, 더 작은 탄체를 장거리까지 쏘아 보낸다. 탄약이 제한적이다. (50발)%n적재값:%fc8  13.5"

[Desc100]		//LIGHT AUTOCANNON
st DescString = "AC/5라고도 불리는 IS 경오토캐논은 장거리에서 빠르게 연사하지만 그 대가로 피해가 적다. 탄약이 제한적이다. (100발)  적재값:%fc8  9.5"

[Desc101]		//AUTOCANNON
st DescString = "IS 오토캐논은 중거리에서 고폭탄을 연달아 퍼붓는 속사 무기이다. 탄약이 제한적이다. (40발)%n적재값:%fc8 15.5"

[Desc102]		//HEAVY AUTOCANNON
st DescString = "일명 AC/20인 이 IS 오토캐논은 한 번의 일제 사격으로 막대한 피해를 입히는 단거리 무기이다. 탄약이 매우 제한적이다. (13발)  적재값:%fc8 19.5"

[Desc103]		//LIGHT ULTRA AUTOCANNON
st DescString = "IS 경울트라 오토캐논은 일반 경오토캐논보다 연사 속도가 빠르다. 탄약이 제한적이다. (112발)%n적재값:%fc8 11.0"

[Desc104]		//GAUSS RIFLE
st DescString = "IS 가우스 라이플은 단단한 탄체를 초음속으로 쏘아 장거리에서 큰 피해를 입힌다. 탄약이 극히 제한적이다. (16발)  적재값:%fc8 16.5" 

[Desc105]		//MACHINE GUN
st DescString = "이 부품에 대한 설명이 아직 준비되지 않았습니다."

[Desc106]		//ANTI MISSILE SYSTEM
st DescString = "이 부품에 대한 설명이 아직 준비되지 않았습니다."

[Desc107]		//LIGHT LBX AUTOCANNON (IS)
st DescString = "LB-X 오토캐논의 경량형으로, 산탄총처럼 퍼지는 더 작은 탄을 장거리까지 쏜다. 탄약이 넉넉하다. (260발) %n적재값:%fc8  9.5"

[Desc108]		//LBX AUTOCANNON (IS)
st DescString = "산탄총 같은 LB-X 오토캐논은 분열탄을 쏘아 여러 장갑 부위를 동시에 타격할 수 있다. 탄약이 제한적이다. (90발)  적재값:%fc8  14.5"

[Desc109]		//HEAVY LBX AUTOCANNON (IS)
st DescString = "이 오토캐논은 여러 장갑 부위를 동시에 타격할 수 있는 거대한 단거리 산탄을 쏜다. 탄약이 제한적이다. (35발) 적재값:%fc8  19.5"

[Desc120]		//LONG-RANGE MISSILES RACK
st DescString = "IS LRM 랙은 벽, 건물 등 지형지물 너머로 미사일을 날려 장거리 목표를 공격할 수 있다. 탄약이 제한적이다. (24발)%n적재값:%fc8  4.0"

[Desc121]		//LONG-RANGE MISSILES/15
st DescString = "이 부품에 대한 설명이 아직 준비되지 않았습니다."

[Desc122]		//LONG-RANGE MISSILES/20
st DescString = "이 부품에 대한 설명이 아직 준비되지 않았습니다."

[Desc123]		//SHORT-RANGE MISSILES PACK
st DescString = "IS SRM 팩은 단거리 미사일을 쏘며, LRM처럼 장애물 너머로도 공격할 수 있다. 탄약이 제한적이다. (62발)%n적재값:%fc8  3.0" 

[Desc124]		//SHORT-RANGE MISSILES/6
st DescString = "이 부품에 대한 설명이 아직 준비되지 않았습니다."

[Desc125]		//STREAK SHORT-RANGE MISSILES Pack
st DescString = "IS 스트릭 SRM 발사기는 명중이 확실할 때만 미사일을 쏜다. 이 미사일도 장애물 너머로 공격할 수 있다. 탄약이 제한적이다. (62발)  적재값:%fc8  5.0" 

[Desc139]		//LARGE X PULSE LASER (IS)
st DescString = "이 속사형 에너지 무기는 구할 수 있는 부품 중 재장전 속도가 가장 빠르며, 장거리 목표도 타격할 수 있다.%n적재값:%fc8  13.0"

[Desc140]		//LARGE LASER
st DescString = "일반 IS 레이저보다 묵직한 대형 레이저는 재장전 시간은 같으면서 중거리에서 더 강력한 타격을 가한다.%n적재값:%fc8  9.5"

[Desc141]		//LARGE ER LASER
st DescString = "대형 레이저의 IS 확장 사거리형으로, 파괴력을 장거리까지 투사한다. 일반 IS 대형 레이저보다 무겁다.  적재값:%fc8 11.0"

[Desc142]		//LARGE PULSE LASER
st DescString = "펄스형은 일반 IS 대형 레이저보다 두 배 자주 발사하지만 더 무겁다.%n적재값:%fc8 12.0"

[Desc143]		//LASER
st DescString = "IS 레이저는 가벼운 단거리 무기이다. 에너지 무기이므로 탄약이 떨어질 일이 없다.%n적재값:%fc8  4.0" 

[Desc144]		//PULSE LASER
st DescString = "펄스 레이저는 일반 IS 레이저의 두 배가 넘는 발사 속도로 고에너지 빔을 여러 줄기 쏘지만, 더 무겁다.  %n적재값:%fc8  6.0"

[Desc145]		//PARTICLE PROJECTOR CANNON
st DescString = "고에너지 입자탄을 쏘는 중거리 IS 입자 투사포는 배틀메크가 쓸 수 있는 가장 효과적인 무기 중 하나이다.  적재값:%fc8 12.0"

[Desc146]		//ER PARTICLE PROJECTOR CANNON
st DescString = "PPC의 값진 개량형인 확장 사거리 IS PPC는 치명적인 에너지탄을 장거리까지 쏜다.%n적재값:%fc8 15.5"

[Desc147]		//HEAVY FLAMER
st DescString = "IS 중화염방사기는 초고온 플라스마를 내뿜는 효과적인 단거리 무기이다.%n적재값:%fc8  8.0"

[Desc160]		//LONG TOM (IS)
st DescString = "롱 톰 포탄은 목표에 8포인트의 피해를 주고, 폭발 반경 안의 모든 대상에게 8포인트의 피해를 더 준다. 탄약이 제한적이다. (25발)  적재값:%fc8  34.0"

[Desc161]		//SNIPER CANNON (IS)
st DescString = "포신이 짧은 이 메크 탑재형 중거리 야포는 범위 효과를 내는 폭발 탄두를 쏘며, 탄약이 제한적이다. (64발)  적재값:%fc8  17.0"

//CLAN COMPONENTS

[Desc16]		//SENSOR (STANDARD)
st DescString = "클랜 표준형 센서는 IS 기본형 센서보다 조금 더 먼 거리에서 가동 중인 적 유닛을 탐지한다. 엘리멘탈이나 전원이 차단된 메크는 탐지하지 못한다.  적재값:%fc8  0.0" 

[Desc17]		//SENSOR (EXTENDED)
st DescString = "클랜 확장형 센서는 가동 중인 적 유닛을 탐지하며, 탐지 거리는 IS 고급형 센서보다 조금 짧다. 엘리멘탈이나 전원이 차단된 메크는 탐지하지 못한다.  적재값:%fc8  0.5" 

[Desc42]		//ECM SUITE
st DescString = "클랜 ECM 장비는 접촉한 적 센서의 효율을 절반 넘게 떨어뜨린다. *레이븐 또는 클랜 경량급 메크 전용.*%n적재값:%fc8  1.0"

[Desc43]		//ACTIVE PROBE
st DescString = "클랜 액티브 프로브를 달면 모든 아군 유닛이 각자의 센서 범위 안에서 전원이 차단된 메크를 탐지할 수 있다. *레이븐 또는 클랜 경량급 메크 전용.*%n적재값:%fc8  1.0"

[Desc110]		//LIGHT ULTRA AUTOCANNON
st DescString = "클랜 경울트라 오토캐논은 이너 스피어판과 같은 빠른 연사 속도를 갖추었지만 더 가볍다. 탄약이 제한적이다. (112발)  적재값:%fc8  8.5"

[Desc111]		//ULTRA AUTOCANNON
st DescString = "클랜 울트라 오토캐논은 이너 스피어 오토캐논보다 연사 속도가 빠르고 더 가볍다. 탄약이 제한적이다. (30발)%n적재값:%fc8 13.5"

[Desc112]		//HEAVY ULTRA AUTOCANNON
st DescString = "클랜 중울트라 오토캐논은 이너 스피어 중오토캐논보다 연사 속도가 빠르고 더 가볍다. 탄약이 매우 제한적이다. (10발)  적재값:%fc8 17.5"

[Desc113]		//GAUSS RIFLE
st DescString = "클랜 가우스 라이플은 장거리에서 이너 스피어판과 같은 피해를 주지만 더 가볍다. 탄약이 매우 제한적이다. (16발)  적재값:%fc8 13.5"

[Desc114]		//MACHINE GUN
st DescString = "이 부품에 대한 설명이 아직 준비되지 않았습니다."

[Desc115]		//ANTI MISSILE SYSTEM
st DescString = "이 부품에 대한 설명이 아직 준비되지 않았습니다."

[Desc116]		//LIGHT LBX AUTOCANNON
st DescString = "경 LB-X 오토캐논의 클랜판으로, 사거리와 피해는 같지만 더 가볍다. 탄약이 제한적이다. (260발)  적재값:%fc8  8.5"

[Desc117]		//LBX AUTOCANNON  
st DescString = "산탄총 같은 클랜 LB-X 오토캐논은 여러 장갑 부위를 타격할 수 있는 탄을 쏘며, IS판보다 가볍다. 탄약이 제한적이다. (90발)  적재값:%fc8  13.5"

[Desc118]		//HEAVY LBX AUTOCANNON
st DescString = "클랜 중 LB-X 오토캐논은 IS판과 같은 단거리 산탄을 쏘지만 더 가볍다. 탄약이 제한적이다. (35발)  적재값:%fc8  17.5"

[Desc126]		//HEAVY THUNDERBOLT
st DescString = "이 발사기는 메크를 무력화하는 중거리 미사일 한 발을 장애물 너머로 쏜다.  50m 이내의 목표에는 신관이 작동하지 않는다. 탄약이 제한적이다. (32발)  적재값:%fc8  21.0"

[Desc130]		//LONG-RANGE MISSILES/5
st DescString = "클랜 LRM 랙은 이너 스피어판과 같은 수의 장거리 미사일을 같은 속도로 쏘지만 더 가볍다. 탄약이 제한적이다. (24발)  적재값:%fc8  3.0"

[Desc131]		//LONG-RANGE MISSILES/15
st DescString = "이 부품에 대한 설명이 아직 준비되지 않았습니다."

[Desc132]		//LONG-RANGE MISSILES/20
st DescString = "이 부품에 대한 설명이 아직 준비되지 않았습니다."

[Desc133]		//SHORT-RANGE MISSILES/2
st DescString = "클랜 SRM은 이너 스피어판보다 조금 더 빠른 속도로 미사일을 쏘며 더 가볍다. 탄약이 제한적이다. (83발)%n적재값:%fc8  3.0" 

[Desc134]		//SHORT-RANGE MISSILES/6
st DescString = "이 부품에 대한 설명이 아직 준비되지 않았습니다."

[Desc135]		//STREAK SHORT-RANGE MISSILES/2
st DescString = "클랜 스트릭 SRM 팩 발사기는 명중이 확실할 때만 단거리 미사일을 쏜다. IS판보다 가볍고 탄약이 제한적이다. (83발)  적재값:%fc8  4.75" 

[Desc136]		//STREAK SHORT-RANGE MISSILES/6
st DescString = "이 부품에 대한 설명이 아직 준비되지 않았습니다."

[Desc150]		//LARGE ER LASER
st DescString = "클랜 확장 사거리 대형 레이저는 장거리까지 피해를 준다. 이너 스피어판보다 조금 가볍지만 위력은 더 세다.%n적재값:%fc8 10.0"

[Desc151]		//LARGE PULSE LASER
st DescString = "클랜 펄스형은 IS 대형 펄스 레이저와 같은 빠른 속도로 발사하지만 더 가볍다.%n적재값:%fc8 11.0"
 
[Desc152]		//ER LASER
st DescString = "클랜 확장 사거리 레이저는 일반 레이저와 같지만, 중거리까지 효과적이며 더 가볍다.%n적재값:%fc8  3.5"

[Desc153]		//PULSE LASER
st DescString = "클랜 펄스 레이저는 IS판과 같은 속도로 발사하지만 더 가볍다.%n적재값:%fc8  4.0"

[Desc154]		//ER PARTICLE PROJECTOR CANNON
st DescString = "ER PPC의 클랜판으로, 이너 스피어판보다 가볍고 피해가 더 크다.%n적재값:%fc8 13.5"

[Desc155]		//HEAVY FLAMER
st DescString = "클랜 중화염방사기는 이너 스피어판보다 조금 더 자주 발사하며 더 가볍다.%n적재값:%fc8  7.0"

//Pilots
[Desc301]	//beast
st DescString = "밴딧 킹덤 출신의 고아이자 난민인 비스트는 신병 훈련소에서 손꼽히는 사수였지만, 포커 실력은 최악이었다."

[Desc302]	//hawk
st DescString = "호크는 먹잇감을 덮치듯 날아들어 숨통을 끊는 실력과, 사소한 접전도 대서사시 같은 전투로 들리게 만드는 입담을 자랑으로 여긴다."

[Desc303]	//Siren
st DescString = "스스로 이름을 지은 명사수 사이렌은 포커 판에서 비스트의 급료를 가장 자주 챙겨 가는 사람이다."

[Desc304]	//Rooster
st DescString = "라이란 연방의 외진 행성에서 나고 자란 루스터는 아무리 좁은 지형에서도 메크를 몰고 빠져나갈 수 있다."

[Desc305]	//Isis
st DescString = "포화 속에서도 침착한 아이시스는 훈련 중 전장 인식 능력에서 높은 점수를 받았다."

[Desc306]	//Gunman
st DescString = "건맨은 이름값 하기를 즐긴다. 알파 스트라이크를 할 때 가장 행복해한다."

[Desc307]	//Mystique
st DescString = "미스틱은 자신의 과거를 말하지 않지만, 메크를 거의 날게 만드는 그녀의 실력은 누구도 의심하지 않는다." 

[Desc308]	//Skater
st DescString = "훈련생 중 스케이터의 메크 조종 실력을 따라올 사람은 거의 없었지만, 그의 유머 감각을 알아주는 사람은 그보다 훨씬 적었다." 

[Desc309]	//Spice
st DescString = "스파이스는 뛰어난 운동 능력으로 가장 다루기 힘든 메크(와 메크워리어)도 힘으로 휘어잡는다." 

[Desc310]	//Baron
st DescString = "다비온 통치 가문과 먼 혈연 관계인 배런과 그의 누나 카운티스는 재규어와 싸우는 것을 자신들의 의무이자 명예이며 권리라고 여긴다."

[Desc311]	//Fiend
st DescString = "이름에 속지 마라. 핀드는 전혀 악마 같은 사람이 아니다. 필요하다면 적당한 이자로 돈도 빌려준다." 

[Desc312]	//Ronin
st DescString = "쿠리타 가문의 먼 후손인 로닌은 반격 소문이 처음 돌았을 때 다비온 근위대로 전속되려고 무던히 애썼다."

[Desc313]	//Gator
st DescString = "한낮에 곧잘 낮잠을 자는 게이터지만, 마지막 필사의 한 발을 반드시 맞혀야 할 때는 그가 꼭 필요하다." 

[Desc314]	//Rebel
st DescString = "스타이너 충성파인 레블은 그 칭호와 기동 훈련 표창을 자랑스럽게 내세운다." 

[Desc315]	//Hunter
st DescString = "잘 지은 호출부호답게 헌터는 누구보다 능숙하게 움직이며 사격한다."

[Desc316]	//Lynx
st DescString = "교활하고 약삭빠른 링크스는 가서는 안 될 곳으로 메크를 점프시킬 기회를 반긴다. 다행히 그에게는 스스로 목숨을 건질 만한 사격 실력이 있다."

[Desc317]	//Hitman
st DescString = "명사수이며 센서도 꽤 잘 다루는 히트맨은 스모크 재규어에게 그들의 죄를 갚아 줄 기회를 반긴다."

[Desc318]	//Countess
st DescString = "남동생 배런처럼 카운티스도 자신을 잃어버린 다비온의 영광을 되찾을 운명을 타고난 고귀한 엘리트 중 하나로 여긴다."

[Desc319]	//Scarab
st DescString = "기계광인 스캐럽은 자기 메크의 센서와 조준 보조 전자 장비를 타 버리기 직전까지 개조해 두었다."

[Desc320]	//Outlaw
st DescString = "아웃로는 다비온군에 말단 보병으로 입대했지만, 운과 적지 않은 재능 덕분에 최정예와 나란히 메크를 몰 자격을 얻었다."

[Desc321]	//Falcon
st DescString = "팰컨의 가문은 다비온군에서 큰 영향력을 지니지만, 그녀는 다른 누구와도 똑같이 대우받기 위해 끊임없이 싸운다."

[Desc322]	//Burnout
st DescString = "격추당하는 데 지친 번아웃은 항공우주군에서 진짜 전투가 벌어지는 곳으로 전속했다. 지금까지는 실망한 적이 없다."

[Desc323]	//Goblin
st DescString = "고블린은 마주치는 스모크 재규어마다 모든 클랜이 저지른 죄의 대가를 치르게 할 각오가 되어 있다. 다행히 그에게는 그럴 만한 실력이 있다."

[Desc324]	//Mantis
st DescString = "맨티스는 첫 침공 때 클랜과 싸웠으며, 다시는 그들에게 지지 않겠다고 맹세했다."

[Desc325]	//Dragon
st DescString = "공공연한 쿠리타 애호가인 드래곤은 클랜의 전술을 연구해 왔으며, 그들에게 싸움을 걸 준비가 충분히 되어 있다."

[Desc326]	//Blaze
st DescString = "요즘은 많이 누그러졌지만, 블레이즈는 무엇이든 최고만 요구하기로 악명이 높다. 하지만 사실 그녀는 그럴 자격이 있다."

[Desc327]	//Thunder
st DescString = "다비온의 베테랑인 선더는 재규어와 싸울 기회를 얻으려고 원래 부대의 지휘관 자리를 떠나 전속했다."

[Desc328]	//Paingod
st DescString = "이너 스피어군 사이에서 전설에 가까운 페인갓의 목표는 노획한 클랜 옴니메크를 몰고 클랜과 싸우는 것이다."

[Desc329]	//Firestorm
st DescString = "그에게 강습급 배틀메크의 조종간을 맡겨 보면 그의 호출부호가 왜 파이어스톰인지 알게 될 것이다."

[Desc330]	//Vixen
st DescString = "빅슨은 다비온 근위대의 거의 누구보다도 많은 전투를 치렀지만, 단 한 번도 조종석 낙하산을 펼쳐 본 적이 없다." 

[Desc331]	// Apollo 
st DescString = "Apollo 
works hard at being the consummate MechWarrior. He spends more time retraining and reviewing cockpit films than any other pilot."
 
[Desc332]	// Boomer
st DescString = "고립된 페리페리 행성에서 자란 부머의 사투리는 알아듣기 어렵다는 말로도 부족하다. 다행히 그는 할 말의 대부분을 메크에게 맡긴다."

[Desc333]	// Detox
st DescString = "이 메크워리어는 막사에서 찾을 수 없다- 디톡스에게는 메크가 집이다. 안타깝게도 그 때문에 청소반은 위험 수당을 받는다..."

[Desc334]	// Ghost
st DescString = "수십 톤의 강철에 둘러싸여 있지 않을 때는 조용하고 냉담한 고스트도 전장에서는 생기가 넘친다. 하지만 그때조차 부대에서 손꼽히게 말수가 적다."

[Desc335]	// Jinx
st DescString = "그녀의 별명은 동료들에게 미치는 영향이 아니라, 그녀가 있을 때마다 적에게 닥치는 듯한 불운에서 나왔다."

[Desc336]	// Needle
st DescString = "군인 가정에서 자란 니들은 군대 생활밖에 모른다. 하지만 형제들과 달리 진급할 생각은 전혀 없다. 그녀는 최전선을 더 좋아한다."

[Desc337]	// Pyro
st DescString = "파이로가 그런 이름을 얻은 이유는 쉽게 짐작할 수 있을 것이다. 하지만 그 집착 뒤에는 예리한 군사적 두뇌와 노련한 전사의 면모가 숨어 있다."

[Desc338]	// Sponge
st DescString = "스펀지가 가진 것은 모두 누군가에게 얻거나 빌리거나 훔친 것이다. 믿기 어렵겠지만 그의 호출부호조차 울프 용기병대의 누군가에게서 슬쩍한 것이다."

[Desc339]	// Squid
st DescString = "스퀴드의 호출부호는 신참 메크워리어 시절의 잔재이다. 이제 더는 풋내기가 아닌 스퀴드는 클랜을 상대로 자신의 기량을 시험해 보기를 고대한다."

[Desc340]	// Toad
st DescString = "베테랑 토드는 조종석 안보다 밖에서 더 심술궂다. 그래서 상관들은 가능할 때마다 그에게 초계 임무를 맡기려 한다."

[Desc341]	// Vandal
st DescString = "많은 이들이 밴덜이 지금껏 살아 있는 것을 놀라워한다. 전장에 감수할 위험이 있다면 그는 그곳으로 돌진한다."

[Desc342]	// Wasp
st DescString = "와스프는 정찰 임무를 좋아하며, 메크는 가볍고 빠를수록 좋아한다. 다행히 질주하는 25톤짜리 쇳덩이를 그녀만큼 잘 모는 사람은 드물다."

[Desc343]	// Spice
st DescString = "숱한 전투를 겪은 스파이스는 힘만이 늘 답은 아니며, 때로는 신중하고 정밀한 손길이 승리를 가져온다는 것을 배웠다." 

[Desc344]	// Baron
st DescString = "스모크 재규어를 상대로 세운 공적이 고향 행성의 뉴스 영상에 방송되면서, 배런은 그 어느 때보다도 더 봐주기 힘든 사람이 되었다." 

[Desc345]	// Fiend
st DescString = "예비 부품 시장에 눈을 뜬 핀드는 자신이 격파한 적 메크에서 회수한 장비 목록에 개인적인 관심을 쏟고 있다." 

[Desc346]	// Ronin
st DescString = "스모크 재규어를 상대로 승리를 거두고 있음에도, 로닌은 드라코니스 연맹의 삶과 문화를 점점 더 그리워하고 있다." 

[Desc347]	// Gator
st DescString = "부대원 일부는 가장 필요한 순간에 어려운 사격을 성공시키는 게이터의 실력을 인정해 그의 이름을 트릭샷으로 바꾸자고 한다."

[Desc348]	// Rebel
st DescString = "골수 다비온 부대에서 지내면서 레블의 스타이너 애국심은 다소 무뎌졌지만, 아직도 이따금 주먹다짐을 일으킬 만큼은 강하다...  " 

[Desc349]	// Hitman
st DescString = "히트맨은 스모크 재규어를 짓밟는 데 힘을 보태며 무척 즐거워하고 있다. 안타깝게도 일부 동료들은 그것이 집착이 되어 가는 것은 아닌지 걱정한다." 

[Desc350]	// Burnout
st DescString = "번아웃은 항공우주기를 몰던 때보다 메크 조종을 더 즐기지만, 이제는 높은 곳에서 싸움을 내려다보는 것의 가치도 알게 되었다."

 //Mechs
[Desc400]	//ATLAS-A
st DescString = "아틀라스는 IS 최고의 강습급 메크이다. 두려워하라. 이 파생형은 장갑이 강화되었고 점프젯이 없다."

[Desc401]	//ATLAS-W
st DescString = "아틀라스는 IS 최고의 강습급 메크이다. 두려워하라. 이 파생형은 무장이 강화되었고 점프젯이 없다."

[Desc402]	//ATLAS-J
st DescString = "아틀라스는 IS 최고의 강습급 메크이다. 두려워하라. 이 희귀한 파생형은 장갑과 무장을 줄이는 대신 점프젯을 갖추었다."

[Desc403]	//AWESOME-A
st DescString = "오섬 강습급 메크는 공격의 선봉에 서서 막대한 피해를 받아 내도록 설계되었다. 이 파생형은 장갑이 강화되었고 점프젯이 없다."

[Desc404]	//AWESOME-W
st DescString = "오섬 강습급 메크는 공격의 선봉에 서서 막대한 피해를 받아 내도록 설계되었다. 이 파생형은 무장이 강화되었고 점프젯이 없다."

[Desc405]	//AWESOME-J
st DescString = "오섬 강습급 메크는 공격의 선봉에 서도록 설계되었다. 이 희귀한 파생형은 장갑과 무장을 줄이는 대신 점프젯을 갖추었다."

[Desc406]	//CATAPULT-A
st DescString = "캐터펄트는 견고한 장갑을 두른 후방 화력 지원 메크이다. 이 파생형은 장갑이 강화되었고 점프젯이 없다."

[Desc407]	//CATAPULT-W
st DescString = "캐터펄트는 견고한 장갑을 두른 후방 화력 지원 메크이다. 이 파생형은 무장이 강화되었고 점프젯이 없다."

[Desc408]	//CATAPULT-J
st DescString = "캐터펄트는 견고한 장갑을 두른 후방 화력 지원 메크이다. 이 파생형은 장갑과 무장을 줄이는 대신 점프젯을 갖추었다."

[Desc409]	//COMMANDO-A
st DescString = "코만도는 흔히 한 기나 두 기씩 파견되어 전방을 정찰하거나 적의 움직임을 감시한다. 이 파생형은 장갑이 강화되었고 점프젯이 없다."

[Desc410]	//COMMANDO-W
st DescString = "코만도는 흔히 한 기나 두 기씩 파견되어 전방을 정찰하거나 적의 움직임을 감시한다. 이 파생형은 무장이 강화되었고 점프젯이 없다."

[Desc411]	//COMMANDO-J
st DescString = "코만도는 흔히 한 기나 두 기씩 파견되어 전방을 정찰하거나 적의 움직임을 감시한다. 이 파생형은 장갑과 무장을 줄이는 대신 점프젯을 갖추었다."

[Desc412]	//COUGAR-A
st DescString = "이 클랜 경량급 메크는 효과적인 중무장 정찰기 또는 고속 공격용 최전선 전투 유닛이다. 이 파생형은 장갑이 강화되었고 점프젯이 없다."

[Desc413]	//COUGAR-W
st DescString = "이 클랜 경량급 메크는 효과적인 중무장 정찰기 또는 고속 공격용 최전선 전투 유닛이다. 이 파생형은 무장이 강화되었고 점프젯이 없다."

[Desc414]	//COUGAR-J
st DescString = "이 클랜 경량급 메크는 효과적인 중무장 정찰기 또는 고속 공격용 최전선 전투 유닛이다. 이 파생형은 장갑과 무장을 줄이는 대신 점프젯을 갖추었다."

[Desc415]	//FIRESTARTER-A
st DescString = "이 메크는 시가전용으로 제작되었으며 효과적인 단거리 무장을 갖추었다. 이 파생형은 장갑이 강화되었고 점프젯이 없다."

[Desc416]	//FIRESTARTER-W
st DescString = "이 메크는 시가전용으로 제작되었으며 중거리와 단거리 무장을 섞어 갖추었다. 이 파생형은 무장이 강화되었고 점프젯이 없다."

[Desc417]	//FIRESTARTER-J
st DescString = "이 메크는 시가전용으로 제작되었으며 효과적인 단거리 무장을 갖추었다. 이 파생형은 장갑과 무장을 줄이는 대신 점프젯을 갖추었다."

[Desc418]	//HOLLANDER-A
st DescString = "홀랜더 II는 가우스 라이플 덕분에 단기전에 효과적인 경량급 화력 지원 메크이다. 이 파생형은 장갑이 강화되었고 점프젯이 없다."

[Desc419]	//HOLLANDER-W
st DescString = "홀랜더 II는 가우스 라이플 덕분에 단기전에 효과적인 경량급 화력 지원 메크이다. 이 파생형은 무장이 강화되었고 점프젯이 없다."

[Desc420]	//HOLLANDER-J
st DescString = "홀랜더 II는 가우스 라이플 덕분에 단기전에 효과적인 경량급 화력 지원 메크이다. 이 파생형은 장갑과 무장을 줄이는 대신 점프젯을 갖추었다."

[Desc421]	//HUNCHBACK-A
st DescString = "헌치백은 시가전에서 발휘하는 파괴적인 단거리 타격력으로 유명하다. 이 파생형은 장갑이 강화되었고 점프젯이 없다."

[Desc422]	//HUNCHBACK-W
st DescString = "헌치백은 시가전에서 발휘하는 파괴적인 단거리 타격력으로 유명하다. 이 파생형은 무장이 강화되었고 점프젯이 없다."

[Desc423]	//HUNCHBACK-J
st DescString = "헌치백은 시가전에서 발휘하는 파괴적인 단거리 타격력으로 유명하다. 이 파생형은 장갑과 무장을 줄이는 대신 점프젯을 갖추었다."

[Desc424]	//HUNCHBACK IIC-A 
