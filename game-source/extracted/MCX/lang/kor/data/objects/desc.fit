st DescString = "클랜 터키나 강습급 메크는 치명적인 장거리 화력을 갖추었고, 너무 가까이 다가오는 것은 무엇이든 박살 낼 수 있다. 이 파생형은 장갑과 무장을 줄이는 대신 점프젯을 갖추었다."

[Desc472]	// Katherine Furey's Vulture
st DescString = "스타 캡틴 캐서린 퓨리는 자신의 중량급 옴니메크 벌처에 추가 장갑과 스타 리그 시대의 유물 무기인 레일건을 장착했다."

[Desc473]	// Marcus Osis' Masakari
st DescString = "스타 캡틴 마커스 오시스는 실험용 X-펄스 레이저로 무장하고 장갑을 대폭 강화한 강습급 옴니메크 마사카리를 조종한다."

[Desc474]	// Burnell Wirth's Turkina
st DescString = "스타 캡틴 버넬 워스가 개조한 강습급 옴니메크 터키나는 선더볼트 미사일 발사기만으로 무장했다."

[Desc475]	// Marcus Kotare's Turkina
st DescString = "Star Colonel Marcus Kotare commands a Turkina class assault OmniMech equipped with jump jets, the Rail Gun, and a Long Tom cannon.

[Desc476]	// Ward's Madcat
st DescString = "스타 캡틴 킴 워드는 장거리 미사일 랙을 가득 실은 개조형 중량급 옴니메크 매드캣을 조종한다."

[Desc477]	// Stiles' Uller
st DescString = "스타 캡틴 제퍼슨 스타일스는 대형 ER 레이저 2문을 장착한 경량급 옴니메크 울러를 운용한다."

[Desc478]	// Bowen's Uller
st DescString = "스타 캡틴 개리슨 보웬은 레일건과 LRM 랙을 달도록 개조한 경량급 옴니메크 울러를 사용한다."

[Desc479]	// Lopez's Uller
st DescString = "스타 캡틴 펠리시아 로페즈는 ER PPC를 장착한 경량급 옴니메크 울러를 조종한다."

